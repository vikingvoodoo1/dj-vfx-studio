{
  "name": "dj-vfx-studio",
  "productName": "DJ VFX Studio",
  "version": "1.0.0",
  "description": "Professional Stage Visual Engine, Reactive Smart Lighting Controller & Multi-Platform DJ Bridge",
  "author": "JK McLaren <info@jkmcalren.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node server/dev-runner.js",
    "dev:vite": "vite",
    "start": "node server/dev-runner.js",
    "bridge": "node server/stagelinq-bridge.js",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron electron/main.cjs --dev",
    "electron:start": "electron electron/main.cjs",
    "electron:pack": "vite build && electron-builder --dir",
    "electron:dist": "vite build && electron-builder"
  },
  "dependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.13.0",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.jkmclaren.djvfxstudio",
    "productName": "DJ VFX Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "AudioVideo"
    }
  }
}