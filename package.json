{
  "name": "dj-vfx-studio",
  "productName": "DJ VFX Studio",
  "version": "2.3.0",
  "description": "Professional Stage Visual Engine, Reactive Smart Lighting Controller & Multi-Platform DJ Bridge",
  "author": "jkmclaren <info@jkmclaren.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node server/dev-runner.js",
    "dev:vite": "vite",
    "start": "node server/dev-runner.js",
    "bridge": "node server/stagelinq-bridge.js",
    "launcher": "node scripts/open-launcher.js",
    "launcher:build": "node scripts/build-native-launchers.js",
    "launcher:build:mac": "bash scripts/build-mac-launcher.sh",
    "launcher:build:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-win-launcher.ps1",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron electron/main.cjs --dev",
    "electron:launcher": "electron electron/main.cjs --dev --launcher",
    "electron:start": "electron electron/main.cjs",
    "electron:pack": "vite build && node scripts/build-native-launchers.js && electron-builder --dir",
    "electron:dist": "vite build && node scripts/build-native-launchers.js && electron-builder"
  },
  "dependencies": {
    "shazamio-core": "^1.3.1",
    "stagelinq": "^3.5.7",
    "three": "^0.160.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.13.0",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.jkmclaren.djvfxstudio",
    "productName": "DJ VFX Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "extraResources": [
        {
          "from": "DJ VFX Launcher.app",
          "to": "DJ VFX Launcher.app"
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "extraFiles": [
        {
          "from": "DJ VFX Launcher.exe",
          "to": "DJ VFX Launcher.exe"
        },
        {
          "from": "DJ VFX Launcher.bat",
          "to": "DJ VFX Launcher.bat"
        }
      ],
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "AudioVideo"
    }
  }
}
